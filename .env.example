# NWS requires a User-Agent identifying your app + contact email.
# Format: "AppName/version (contact@email)"
NWS_USER_AGENT="LoCoWX/0.1 (contact@example.com)"

# EPA AirNow API key — free signup at https://docs.airnowapi.org
AIRNOW_API_KEY=""

# Supabase (auth + per-user settings).
# Get these from Supabase Dashboard → Project Settings → API.
# - URL is the project URL
# - ANON KEY is the "anon public" key (safe to ship to the browser; RLS
#   policies enforce per-user data access)
# - SERVICE_ROLE_KEY bypasses RLS — used ONLY by the daily-briefing cron
#   to iterate across all opted-in users. Keep server-side; never expose
#   to the browser.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend — transactional email provider for the daily briefing.
# Free tier is 100 emails/day, 3000/month.
# - API_KEY from https://resend.com/api-keys
# - FROM_EMAIL is the "From:" address; must be on a domain you've
#   verified in Resend (e.g. auth.tidevisor.com). Format "Name <addr>".
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Tidevisor <noreply@auth.tidevisor.com>"

# Shared secret for the daily-briefing cron endpoint. Vercel Cron sends
# this as `Authorization: Bearer <secret>`. Generate a random string
# (e.g. `openssl rand -hex 32`) and set the same value in Vercel.
CRON_SECRET=""

# Base URL used in email "Open dashboard" / "Manage settings" links.
# Production: https://tidevisor.com. Local dev: leave blank — the
# preview route uses request origin for that case.
APP_BASE_URL="https://tidevisor.com"

# Stripe — Tidevisor Pro subscription tier.
#
# Required for the upgrade flow, customer portal, and webhook handler.
# See lib/stripe-server.ts header for the full setup walkthrough.
#
# Secret key (Developers > API keys in the Stripe dashboard):
#   sk_test_... in Test Mode, sk_live_... in production.
STRIPE_SECRET_KEY=""

# Webhook signing secret (Developers > Webhooks > select your endpoint
# > Signing secret). Used to verify that webhook calls actually
# originated from Stripe. Set after you've configured the webhook
# endpoint pointing at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=""

# Price IDs for the three plans. Create each plan as a Product in
# Stripe (Products > Add product), then copy the Price ID (starts with
# "price_") from the product page. Pricing must match what's shown
# on /upgrade — the displayed price strings live in lib/stripe-server.ts
# PLANS, but Stripe is the source of truth for what users actually pay.
#
#   STRIPE_PRICE_MONTHLY   — recurring $2.99/month
#   STRIPE_PRICE_ANNUAL    — recurring $19/year
#   STRIPE_PRICE_LIFETIME  — one-time $59
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
STRIPE_PRICE_LIFETIME=""

# Base URL for Stripe success/cancel redirects. Production: your apex
# domain. Local dev: http://localhost:3000. Used by the checkout
# session creation server action to build return URLs that Stripe
# sends users back to.
NEXT_PUBLIC_APP_URL="https://tidevisor.com"

# Admin user IDs — comma-separated list of Supabase auth user IDs that
# can access /admin/comp-codes. Copy the IDs from Supabase Dashboard >
# Authentication > Users. Leave blank to lock the admin tools entirely.
# Stays server-side (no NEXT_PUBLIC_ prefix); never shipped to the browser.
ADMIN_USER_IDS=""
